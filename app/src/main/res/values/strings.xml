    <!-- About tab -->
    <string name="nav_about">About</string>
    <string name="about_app_title">VPSH</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_description">VPSH shares your phone\'s internet with other devices over USB tethering or a Wi‑Fi hotspot — either as a full transparent VPN share (needs root) or as a local proxy (no root needed). BatProxy is a separate, second way to get online: it tunnels your own device\'s traffic through Cloudflare Workers, useful when your regular connection is blocked or unreliable.</string>

    <string name="about_features_title">What\'s inside</string>
    <string name="about_feature_proxy">Proxy mode — share your VPN with other devices, no root required</string>
    <string name="about_feature_full">Full mode — transparent NAT sharing for rooted devices</string>
    <string name="about_feature_batproxy">BatProxy — tunnels the whole device through Cloudflare Workers, acting as its own VPN</string>
    <string name="about_feature_bilingual">Fully bilingual — English and Persian, switchable anytime from Settings</string>
    <string name="about_feature_killswitch">Kill-switch, health checks, and auto-restart so a dropped VPN never silently leaks</string>

    <!-- About: tab-by-tab guide -->
    <string name="about_guide_title">What each tab does</string>
    <string name="about_guide_dashboard_title">Dashboard</string>
    <string name="about_guide_dashboard_desc">The main screen. \"Sharing mode\" switches between Proxy and Full (Full is greyed out without root). \"Start sharing / Stop sharing\" turns the foreground service on or off — once it\'s on, a persistent notification with its own Stop button lets you turn it off without opening the app again. The QR button next to Start shows the phone\'s IP, HTTP/SOCKS5 ports, and login (if you turned on authentication) as a scannable code. Stat chips show connected clients and traffic, and the device list lets you rename or block each connected client.</string>
    <string name="about_guide_batproxy_title">BatProxy</string>
    <string name="about_guide_batproxy_desc">Connect / Disconnect turns the Cloudflare Workers tunnel on or off. The worker list is where you add or remove worker URLs and passwords; changing it while connected requires a reconnect. The live dashboard (Active / Total / OK / Fail) shows each worker\'s health — healthy, recovering, or cooling down after failures.</string>
    <string name="about_guide_settings_title">Settings</string>
    <string name="about_guide_settings_desc">HTTP and SOCKS5 ports, optional username/password, health‑check interval, network interface overrides, the proxy‑mode kill‑switch (pauses sharing if the phone\'s VPN drops), chaining through another local proxy (for VLESS/VMess/Shadowsocks clients), and the language switcher.</string>
    <string name="about_guide_logs_title">Logs</string>
    <string name="about_guide_logs_desc">A live feed of client connects/disconnects, proxy errors, and automatic restarts triggered by the health monitor (up to 5 attempts before it gives up).</string>

    <!-- About: proxy mode vs full mode -->
    <string name="about_mode_title">Proxy mode vs. Full mode</string>
    <string name="about_mode_proxy_desc">No root needed. An HTTP proxy (and optional SOCKS5 proxy) runs on the phone; other devices must manually enter the phone\'s IP and port in their own proxy settings — only traffic that goes through that proxy is shared.</string>
    <string name="about_mode_full_desc">Needs root (Magisk or similar). Uses iptables/NAT to share the phone\'s entire active VPN with the tethering/hotspot interface — connected devices need zero configuration, and all of their traffic is covered.</string>

    <!-- About: ready-made clients -->
    <string name="about_clients_title">Ready-made clients</string>
    <string name="about_clients_desc">In Proxy mode, other devices need their proxy settings configured manually. These two scripts do that automatically — enter the phone\'s IP/port (or scan for it) and they set up the system proxy, test the connection, and can save it as a profile for next time.</string>
    <string name="about_client_windows">Client — Windows (.bat)</string>
    <string name="about_client_linux">Client — Linux (.sh)</string>

